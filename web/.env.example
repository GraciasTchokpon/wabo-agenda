# Copiez ce fichier en .env.local (en local) ou saisissez ces variables dans Vercel.
# Sans Supabase, le site fonctionne quand même avec les événements de data/events.json.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé secrète : uniquement côté serveur, ne jamais la publier
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Adresse publique du site (pour les liens de partage et le référencement)
NEXT_PUBLIC_SITE_URL=https://wabo.bj

# Numéro WhatsApp de Wabo au format international sans + (ex. 22901XXXXXXXX). Vide = bouton masqué.
NEXT_PUBLIC_WABO_WHATSAPP=

# Accès au back-office /admin (authentification simple du navigateur)
ADMIN_USER=wabo
ADMIN_PASSWORD=changez-moi
